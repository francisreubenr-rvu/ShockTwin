# Local demo defaults. All seeded business data is Illustrative.
PORT=4004
S4_MOCK_PORT=4005
SIGNALS_PORT=4006
ML_PORT=8000
ML_URL=http://127.0.0.1:8000
S4_URL=http://127.0.0.1:4005
SIGNALS_URL=http://127.0.0.1:4006
NO_OPEN=0
# Optional OpenAI-compatible local explanation endpoint. Empty means deterministic templates.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional authorized signals endpoint; unset keeps the offline Illustrative feed.
LIVE_SIGNALS_URL=
# Production overrides require configured SAP services, authorization and validation [VERIFY].
# S4_URL=https://your-s4-host/sap/opu/odata/sap/API_PURCHASEORDER_PROCESS_SRV
S4_ACCESS_TOKEN=
S4_DESTINATION_NAME=
# SAP purchasing organizational values must be approved by the pilot owner.
S4_COMPANY_CODE=
S4_PURCHASING_ORG=
S4_PURCHASING_GROUP=
S4_PLANT=
BPA_API_URL=
BPA_API_TOKEN=
BPA_DEFINITION_ID=
# Authorized decision bridge resolves the actual task and verifies Buyer authority.
BPA_DECISION_URL=
GENAI_HUB_URL=
GENAI_HUB_TOKEN=
GENAI_HUB_MODEL=
# Supplied by platform rather than checked into .env in production:
# CDS_ENV=production
# VCAP_SERVICES=service bindings injected by Cloud Foundry
